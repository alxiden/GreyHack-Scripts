	for user in users
		plain_password = cryptools.decipher(user.value)
		print(user.key + ":"+ plain_password)
		cracked_users[user.key] = plain_password	
	end for
end if

print(cracked_users)

end function

cracking_mail = function()

print("--------------Cracking Mail Passwords--------------")
cracked_mail = {}

if mail != {} then
	for email in mail
		details = email.value.split(":")
		plain_password = cryptools.decipher(details[1])
		cracked_mail[details[0]] = plain_password	
	end for
end if

print(cracked_mail)

end function

