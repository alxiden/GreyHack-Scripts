clean_memory_text = function(text)
	key_words = []
	split_string = text.split("\.")
	for string in split_string
		//print("String: " + string)
		check = string.indexOf("Unsafe check:")
		//print("Position: " + check)
		if check != null then
			//print("Original String: " + string)
			rm_string = string.indexOf("Unsafe check: string copy in ")
			rm_loop = string.indexOf("Unsafe check: loop in array ")
			//print("rm_string = " + rm_string)
			//print("rm_loop = " + rm_loop)
			if rm_string > rm_loop then
				//print("rm_string active")
				num = rm_string + 29
				string_splice = string[num:]
				//print("Cut String: " + string_splice)
				key_words.insert(0, string_splice)
				//print(key_words)
			else if rm_loop > rm_string then
				//print("rm_loop active")
				num = rm_loop + 28
				string_splice = string[num:]
				//print("Cut String: " + string_splice)
				key_words.insert(0, string_splice)
				//print(key_words)
			end if
		end if
	end for
	//print(key_words)
	return key_words
end function

scanner = function(ip, port = null)
	exploits = {}
	id = 0
	if port == null then
		net_session = metaxploit.net_use(ip)
	else
		net_session = metaxploit.net_use(ip, port)
	end if

	//Test Connection
	if not net_session then exit("Error: Failed to connect!")

	//libary collection
	metaLib = net_session.dump_lib
	//Libary scanning
	print("------Scanning------")
	scans = metaxploit.scan(metaLib)
	//print(scans)
	for scan in scans
		memory = metaxploit.scan_address(metaLib,scan)
		//print(scan)
		memory_words = clean_memory_text(memory)
		exploits[scan] = memory_words
		//print(scan + " " + memory)
	end for	
	print("------Scan Complete ------")
	return exploits
end function

targets = scanner(ip_address, port)

