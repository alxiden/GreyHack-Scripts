clean_memory_text = function(text)
	key_words = []
	split_string = text.split("\.")
	for string in split_string
		//print("String: " + string)
		rm_bold = string.remove("<b>")
		rm_bold2= rm_bold.remove("</b>")
		check = rm_bold2.indexOf("Unsafe check:")
		//print("Position: " + check)
		if check != null then
			//print("Original String: " + string)
			rm_string = rm_bold2.indexOf("Unsafe check: string copy in ")
			rm_loop = rm_bold2.indexOf("Unsafe check: loop in array ")
			//print("rm_string = " + rm_string)
			//print("rm_loop = " + rm_loop)
			if rm_string > rm_loop then
				//print("rm_string active")
				num = rm_string + 29
				string_splice = rm_bold2[num:]
				//print("Cut String: " + string_splice)
				key_words.insert(0, string_splice)
				//print(key_words)
			else if rm_loop > rm_string then
				//print("rm_loop active")
				num = rm_loop + 28
				string_splice = rm_bold2[num:]
				//print("Cut String: " + string_splice)
				key_words.insert(0, string_splice)
				//print(key_words)
			end if
		end if
	end for
	//print(key_words)
	return key_words
end function

